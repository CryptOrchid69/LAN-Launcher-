    def pulse_editor_error_highlight(self):
        if self.editor_error_range is None:
            self.editor_error_pulse_timer.stop()
            return

        self.editor_error_pulse_bright = not self.editor_error_pulse_bright
        self.apply_editor_error_highlight()

    def apply_editor_error_highlight(self):
        if self.editor_error_range is None:
            self.display_window.setExtraSelections([])
            return

        start_position, end_position = self.editor_error_range
        selection = QTextEdit.ExtraSelection()
        selection.cursor = QTextCursor(self.display_window.document())
        selection.cursor.setPosition(start_position)
        selection.cursor.setPosition(end_position, QTextCursor.MoveMode.KeepAnchor)
        selection.format = QTextCharFormat()
        selection.format.setForeground(QColor("#ff0000" if self.editor_error_pulse_bright else "#9a0000"))
        selection.format.setBackground(QColor("#ffe6e6" if self.editor_error_pulse_bright else "#ffffff"))
        self.display_window.setExtraSelections([selection])

    def editor_line_range(self, line_number, column_number):
        lines = self.display_window.toPlainText().splitlines(keepends=True)
        if not lines:
            return (0, 0)

        line_index = min(max(line_number - 1, 0), len(lines) - 1)
        line_start = sum(len(line) for line in lines[:line_index])
        line_text = lines[line_index]
        stripped_newline_length = len(line_text.rstrip("\r\n"))
        start_position = line_start
        end_position = line_start + max(stripped_newline_length, 1)

        if column_number > 0 and column_number < stripped_newline_length:
            start_position = line_start + column_number

        return (start_position, end_position)

