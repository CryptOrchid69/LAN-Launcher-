class InstallWorker(QThread):
    log_signal = pyqtSignal(str)
    speak_signal = pyqtSignal(str)
    finished_signal = pyqtSignal(bool)

    def run(self):
        install_completed = False
        try:
            install_completed = self.install_dayz_server_layout()
        except OSError as error:
            self.log(f"ERROR: Windows blocked the INSTALL setup: {error}")
            self.log("Run LAN Launcher as administrator and try INSTALL again.")
        finally:
            self.finished_signal.emit(install_completed)

    def log(self, message):
        self.log_signal.emit(message)

    def speak(self, message):
        self.speak_signal.emit(message)

    def install_dayz_server_layout(self):
        self.log("INSTALL started.")
        self.log(f"Steam common folder: {STEAM_COMMON_DIR}")

        if not STEAM_COMMON_DIR.exists():
            self.log("ERROR: Steam common folder was not found.")
            self.log("Install Steam or choose the correct Steam library location in a later build.")
            return False

        if self.dayz_server_install_is_stable():
            self.log("DayZServer is already installed and Steam install state is stable.")
            self.log("Using the existing DayZServer folder for this INSTALL pass.")
        else:
            if self.dayz_server_is_installed() and not DAYZ_SERVER_APP_MANIFEST.exists():
                self.log("ERROR: A leftover DayZServer folder was found, but Steam does not show DayZServer as installed.")
                self.log("Click UNINSTALL to move the leftover DayZServer folder to the Recycle Bin, then click INSTALL again.")
                self.speak("A leftover Day Zee Server folder was found. Click uninstall first, then click install again.")
                return False

            self.log("DayZ Server is not installed in the Steam common folder yet.")
            self.log("Opening Steam to the DayZ Server install page.")
            self.open_steam_uri(DAYZ_SERVER_STEAM_URI, "DayZ Server")
            self.log("If Steam asks for confirmation, click Install for DayZ Server.")
            self.log("Waiting for Steam to finish installing DayZ Server.")

            if not self.wait_for_dayz_server_install():
                self.log("DayZ Server was not detected before the install wait time ended.")
                self.log("Steam did not create the DayZServer folder or DayZServer_x64.exe.")
                self.log("Finish the Steam install, then click INSTALL again.")
                return False

        self.log(f"Shared DayZ Server base found: {DAYZ_SERVER_SOURCE_DIR}")
        if not self.verify_dayz_server_base():
            return False

        self.verify_dayz_tools()
        if not self.verify_required_base_mods():
            return False

        MANAGED_SERVER_ROOT.mkdir(exist_ok=True)
        self.log(f"Map folder root ready: {MANAGED_SERVER_ROOT}")

        self.log("Preparing supported map folders:")
        for server_layout in SERVER_LAYOUTS:
            self.create_server_layout(server_layout)
            self.log(f"- {server_layout['map_name']}")

        if not self.install_mission_templates():
            return False

        self.log("Required base mods are assigned to all supported map mod lists.")
        self.log("Known map mods are assigned to their matching map mod lists.")
        self.log("Available mission folders are installed into DayZServer mpmissions.")
        self.log("Workshop map downloads are still limited to verified mod IDs.")
        self.log("INSTALL finished.")
        self.log("Installation Completed.")
        return True

    def dayz_server_is_installed(self):
        return (DAYZ_SERVER_SOURCE_DIR / DAYZ_SERVER_EXE).exists()

    def dayz_server_install_is_stable(self):
        return (
            self.dayz_server_is_installed()
            and self.dayz_server_manifest_is_fully_installed()
            and not DAYZ_SERVER_DOWNLOADING_DIR.exists()
            and not DAYZ_SERVER_TEMP_DIR.exists()
        )

    def dayz_server_manifest_is_fully_installed(self):
        try:
            manifest_text = DAYZ_SERVER_APP_MANIFEST.read_text(encoding="utf-8", errors="ignore")
        except OSError:
            return False

        state_match = re.search(r'"StateFlags"\s+"(\d+)"', manifest_text)
        if state_match is None:
            return False

        state_flags = int(state_match.group(1))
        return bool(state_flags & 4)

    def open_steam_uri(self, steam_uri, label):
        try:
            os.startfile(steam_uri)
        except OSError as error:
            self.log(f"ERROR: Could not open Steam for {label}: {error}")

    def wait_for_dayz_server_install(self):
        waited_seconds = 0
        while waited_seconds < INSTALL_WAIT_SECONDS:
            if self.dayz_server_install_is_stable():
                self.log("DayZ Server install detected and Steam install state is stable.")
                return True

            time.sleep(INSTALL_POLL_SECONDS)
            waited_seconds += INSTALL_POLL_SECONDS
            if waited_seconds % 60 == 0:
                waited_minutes = waited_seconds // 60
                self.log(f"Still waiting for Steam to install DayZ Server... {waited_minutes} minute(s).")
                if self.dayz_server_is_installed():
                    self.log("DayZServer_x64.exe exists, but Steam is still finishing the install.")

        return False

    def verify_dayz_server_base(self):
        missing_paths = [path for path in REQUIRED_DAYZ_SERVER_PATHS if not path.exists()]
        if not missing_paths:
            self.log("Required DayZ Server base files verified.")
            return True

        self.log("ERROR: DayZ Server installed, but required base files are missing:")
        for missing_path in missing_paths:
            self.log(f"- {missing_path}")
        return False

    def verify_dayz_tools(self):
        if DAYZ_TOOLS_SOURCE_DIR.exists():
            self.log(f"DayZ Tools folder detected: {DAYZ_TOOLS_SOURCE_DIR}")
        else:
            self.log("DayZ Tools is not installed yet.")
            self.log("Opening Steam to the DayZ Tools install page.")
            self.open_steam_uri(DAYZ_TOOLS_STEAM_URI, "DayZ Tools")
            self.log("If Steam is still downloading DayZ Tools, let it finish in the background.")

    def verify_required_base_mods(self):
        all_required_mods_ready = True
        self.log("Checking required and known map Workshop mods:")

        for mod_info in KNOWN_WORKSHOP_MODS:
            mod_folder = DAYZ_SERVER_SOURCE_DIR / mod_info["folder"]
            if mod_folder.exists():
                self.log(f"- {mod_info['folder']} detected in DayZServer.")
                self.deposit_mod_keys(mod_info, mod_folder)
                continue

            workshop_source = self.get_workshop_mod_source(mod_info)
            if workshop_source.exists():
                self.log(f"- {mod_info['folder']} found in Steam Workshop downloads.")
                self.copy_workshop_mod(mod_info, workshop_source, mod_folder)
                self.deposit_mod_keys(mod_info, mod_folder)
                continue

            bundled_source = self.get_bundled_mod_source(mod_info)
            if bundled_source is not None:
                self.log(f"- {mod_info['folder']} found in the LAN Launcher app folder.")
                self.copy_workshop_mod(mod_info, bundled_source, mod_folder)
                self.deposit_mod_keys(mod_info, mod_folder)
                continue

            all_required_mods_ready = False
            self.log(f"- {mod_info['folder']} is missing.")
            self.open_workshop_page(mod_info)

        if all_required_mods_ready:
            self.log("Required base mods and known map mods verified.")
            return True

        self.log("Some required or known map mods are not ready yet.")
        self.log("Steam Workshop pages were opened for the missing mods.")
        self.log("Subscribe to the missing mods, let Steam download them, then click INSTALL again.")
        return False

    def get_workshop_mod_source(self, mod_info):
        return STEAM_WORKSHOP_CONTENT_DIR / mod_info["workshop_id"]

    def get_bundled_mod_source(self, mod_info):
        for source_root in (APP_DIR, RESOURCE_DIR, APP_DIR.parent, PRACTICE_DAYZ_SERVER_DIR):
            mod_source = source_root / mod_info["folder"]
            if mod_source.exists() and mod_source.is_dir():
                return mod_source
        return None
    def open_workshop_page(self, mod_info):
        steam_page_uri = f"steam://url/CommunityFilePage/{mod_info['workshop_id']}"
        try:
            os.startfile(steam_page_uri)
            self.log(f"Opened Steam Workshop page for {mod_info['name']}.")
        except OSError:
            try:
                os.startfile(mod_info["workshop_url"])
                self.log(f"Opened browser Workshop page for {mod_info['name']}.")
            except OSError as error:
                self.log(f"ERROR: Could not open Workshop page for {mod_info['name']}: {error}")
                self.log(mod_info["workshop_url"])

    def copy_workshop_mod(self, mod_info, workshop_source, mod_folder):
        self.log(f"Copying {mod_info['folder']} into the DayZServer folder.")
        shutil.copytree(workshop_source, mod_folder, dirs_exist_ok=True)
        self.log(f"{mod_info['folder']} installed at: {mod_folder}")

    def deposit_mod_keys(self, mod_info, mod_folder):
        copied_count = self.copy_mod_keys(mod_folder)
        if copied_count:
            self.log(f"{mod_info['folder']} key file(s) deposited into the DayZServer keys folder.")
        else:
            self.log(f"{mod_info['folder']} has no .bikey files ready to deposit.")

    def copy_mod_keys(self, mod_folder):
        source_keys_dir = self.find_child_folder_case_insensitive(mod_folder, "keys")
        if not source_keys_dir.exists():
            source_keys_dir = self.find_child_folder_case_insensitive(mod_folder, "key")
        if not source_keys_dir.exists():
            return 0

        destination_keys_dir = DAYZ_SERVER_SOURCE_DIR / "keys"
        destination_keys_dir.mkdir(exist_ok=True)

        copied_count = 0
        for key_path in source_keys_dir.glob("*.bikey"):
            shutil.copy2(key_path, destination_keys_dir / key_path.name)
            copied_count += 1

        if copied_count:
            self.log(f"Copied {copied_count} key file(s) from {mod_folder.name}.")

        return copied_count

    def find_child_folder_case_insensitive(self, parent_folder, child_name):
        exact_folder = parent_folder / child_name
        if exact_folder.exists():
            return exact_folder

        try:
            for child_folder in parent_folder.iterdir():
                if child_folder.is_dir() and child_folder.name.lower() == child_name.lower():
                    return child_folder
        except OSError:
            pass

        return exact_folder

    def install_mission_templates(self):
        destination_root = DAYZ_SERVER_SOURCE_DIR / "mpmissions"
        destination_root.mkdir(exist_ok=True)
        self.log("Installing available mission folders into DayZServer mpmissions:")
        missing_required_templates = []

        for server_layout in SERVER_LAYOUTS:
            mission_template = server_layout["mission_template"]
            mission_source = self.find_mission_template_source(server_layout)
            mission_destination = destination_root / mission_template

            if mission_source is None:
                self.log(f"- {server_layout['map_name']}: {mission_template} not found in the LAN Launcher mission library.")
                if mission_template != "dayzOffline.badlands":
                    missing_required_templates.append(mission_template)
                continue

            shutil.copytree(
                mission_source,
                mission_destination,
                dirs_exist_ok=True,
                ignore=self.ignore_mission_runtime_data,
            )
            if mission_destination.exists():
                self.log(f"- {server_layout['map_name']}: {mission_template} installed.")
            else:
                self.log(f"- {server_layout['map_name']}: ERROR: {mission_template} was not copied.")
                if mission_template != "dayzOffline.badlands":
                    missing_required_templates.append(mission_template)

        if missing_required_templates:
            self.log("ERROR: These required mission templates were not installed:")
            for missing_template in missing_required_templates:
                self.log(f"- {missing_template}")
            return False

        return True

    def find_mission_template_source(self, server_layout):
        mission_template = server_layout["mission_template"]

        for mod_name in server_layout.get("workshop_mods", ()):
            if not mod_name.startswith("@"):
                continue

            mod_mission_root = DAYZ_SERVER_SOURCE_DIR / mod_name / "mpmissions"
            mod_mission_source = self.find_mission_template_in_root(mod_mission_root, mission_template)
            if mod_mission_source is not None:
                return mod_mission_source

        for source_root in MISSION_TEMPLATE_SOURCE_ROOTS:
            mission_source = self.find_mission_template_in_root(source_root, mission_template)
            if mission_source is not None:
                return mission_source

        return None

    def find_mission_template_in_root(self, source_root, mission_template):
        exact_source = source_root / mission_template
        if exact_source.exists() and exact_source.is_dir():
            return exact_source

        try:
            for child_folder in source_root.iterdir():
                if child_folder.is_dir() and child_folder.name.lower() == mission_template.lower():
                    return child_folder
        except OSError:
            return None

        return None

    def ignore_mission_runtime_data(self, folder_path, names):
        ignored_names = []
        for name in names:
            lower_name = name.lower()
            if lower_name.startswith("storage_"):
                ignored_names.append(name)

        return ignored_names

    def create_server_layout(self, server_layout):
        server_root = MANAGED_SERVER_ROOT / server_layout["folder"]
        config_dir = server_root / "config"
        keys_dir = server_root / "keys"
        mods_dir = server_root / "mods"

        for folder_path in (server_root, config_dir, keys_dir, mods_dir):
            folder_path.mkdir(exist_ok=True)

        self.write_server_info(server_layout, server_root)
        self.write_mod_list(server_layout, mods_dir)
        self.write_config_placeholder(server_layout, config_dir)
        self.install_profile_template(server_layout, server_root)
        self.log(f"{server_layout['map_name']} map folder ready: {server_layout['folder']}")

    def install_profile_template(self, server_layout, server_root):
        profiles_dir = server_root / "profiles"
        if not PROFILE_TEMPLATE_DIR.exists():
            self.log(f"{server_layout['map_name']}: profile template was not found yet.")
            return

        profiles_dir.mkdir(exist_ok=True)
        copied_profile_folders = 0

        for folder_name in PROFILE_TEMPLATE_COPY_FOLDERS:
            source_folder = PROFILE_TEMPLATE_DIR / folder_name
            if not source_folder.exists() or not source_folder.is_dir():
                continue

            shutil.copytree(source_folder, profiles_dir / folder_name, dirs_exist_ok=True)
            copied_profile_folders += 1

        if copied_profile_folders:
            self.log(f"{server_layout['map_name']}: clean profile template installed.")
        else:
            self.log(f"{server_layout['map_name']}: no clean profile template folders were found.")

    def write_server_info(self, server_layout, server_root):
        info_path = server_root / "SERVER INFO.txt"
        if info_path.exists():
            return

        info_text = (
            f"LAN Launcher Server Profile: {server_layout['map_name']}\n"
            "========================================\n\n"
            "This folder is managed by LAN Launcher.\n\n"
            "It is designed to use one shared Steam DayZServer base folder instead of\n"
            "copying the full DayZServer install into every map folder.\n\n"
            f"Shared base server folder:\n{DAYZ_SERVER_SOURCE_DIR}\n\n"
            "This map folder can have its own config, keys, and mod list.\n"
            "Every map profile uses the required base mods @CF and @VPPAdminTools.\n"
            "Maps with known Workshop mods also load their matching map mod.\n"
            "The profiles folder is copied from the LAN Launcher profile template during INSTALL.\n"
        )
        info_path.write_text(info_text, encoding="utf-8")

    def write_mod_list(self, server_layout, mods_dir):
        mod_list_path = mods_dir / "mod_list.txt"
        existing_lines = []
        if mod_list_path.exists():
            existing_lines = mod_list_path.read_text(encoding="utf-8").splitlines()

        required_lines = [mod_info["folder"] for mod_info in REQUIRED_BASE_MODS]
        required_lines.extend(
            workshop_mod for workshop_mod in server_layout["workshop_mods"] if workshop_mod.startswith("@")
        )
        preserved_lines = [line for line in existing_lines if line.strip() not in required_lines]

        if not preserved_lines:
