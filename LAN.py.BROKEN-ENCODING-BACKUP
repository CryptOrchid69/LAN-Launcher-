    def parse_direct_lan_target(self, target_text):
        match = re.search(r"\b([A-Za-z0-9.-]{1,253}):(\d{1,5})\b", target_text)
        if match is None:
            return None

        host = match.group(1)
        port = int(match.group(2))
        if port < 1 or port > 65535:
            return None

        return host, str(port)

    def direct_lan_target_is_experimental(self, target_text):
        normalized_text = (target_text or "").casefold()
        return (
            "experimental" in normalized_text
            or "exp server" in normalized_text
            or normalized_text.startswith("exp ")
            or " exp " in normalized_text
        )

    def open_dayz_direct_connect(self, host, port, experimental_target=False):
        launch_arguments = [f"-connect={host}", f"-port={port}"]
        app_id = DAYZ_EXPERIMENTAL_APP_ID if experimental_target else DAYZ_WORKSHOP_APP_ID
        battleye_exe = DAYZ_EXPERIMENTAL_BATTLEYE_EXE if experimental_target else DAYZ_BATTLEYE_EXE
        client_exe = DAYZ_EXPERIMENTAL_CLIENT_EXE if experimental_target else DAYZ_CLIENT_EXE
        app_name = "DayZ Experimental" if experimental_target else "DayZ"
        steam_uri = f"steam://run/{app_id}//-connect={host}%20-port={port}"
        try:
            self.close_running_dayz_client_for_direct_connect()
            if battleye_exe.exists():
                subprocess.Popen(
                    [str(battleye_exe), *launch_arguments],
                    cwd=str(battleye_exe.parent),
                )
                self.append_display_message(f"{app_name} BattleEye is launching and attempting to join the server now.")
                self.append_display_message("Direct Server Connect is using the BattleEye join path for LAN, Community, or Official servers.")
                self.speak("Direct Server Connect is joining the server now.")
                return

            if client_exe.exists():
                subprocess.Popen(
                    [str(client_exe), *launch_arguments],
                    cwd=str(client_exe.parent),
                )
                self.append_display_message(f"{app_name} is launching and attempting to join the server now.")
                self.append_display_message("Direct Server Connect is using the fastest join path for LAN, Community, or Official servers.")
                self.speak("Direct Server Connect is joining the server now.")
                return

            if STEAM_EXE.exists():
                subprocess.Popen(
                    [str(STEAM_EXE), "-applaunch", app_id, *launch_arguments],
                    cwd=str(STEAM_EXE.parent),
                )
                self.append_display_message(f"Steam is opening {app_name} and attempting to join the server now.")
                self.append_display_message(f"If Steam asks for confirmation, allow it to launch {app_name}.")
                self.speak("Direct Server Connect is joining the server now.")
                return

            os.startfile(steam_uri)
            self.append_display_message(f"Steam is opening {app_name} and attempting to join the server now.")
            self.append_display_message(f"If Steam asks for confirmation, allow it to launch {app_name}.")
            self.speak("Direct Server Connect is joining the server now.")
            return

        except OSError as error:
            try:
                os.startfile(steam_uri)
            except OSError:
                self.append_display_message(f"ERROR: Direct Server Connect could not launch {app_name}: {error}")
                self.speak("Direct Server Connect could not launch Day Zee.")
                return

            self.append_display_message(f"Steam is opening {app_name} and attempting to join the server now.")
            self.append_display_message(f"If Steam asks for confirmation, allow it to launch {app_name}.")
            self.speak("Direct Server Connect is joining the server now.")
            return

    def close_running_dayz_client_for_direct_connect(self):
        closed_any_client = False
        for process_name in ("DayZ_x64.exe", "DayZ_BE.exe", "DayZDiag_x64.exe"):
            result = subprocess.run(
                ["taskkill", "/F", "/T", "/IM", process_name],
                capture_output=True,
                text=True,
                creationflags=subprocess.CREATE_NO_WINDOW,
            )
            if result.returncode == 0:
                closed_any_client = True

        if closed_any_client:
            self.append_display_message("Existing DayZ client closed so Direct Server Connect can use the new server address.")
            time.sleep(2)

