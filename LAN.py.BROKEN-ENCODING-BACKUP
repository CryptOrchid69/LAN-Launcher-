            self.show_editor_back_button()
            self.speak("This file cannot be edited by LAN Launcher.")
            return

        try:
            file_text = file_path.read_text(encoding="utf-8")
        except UnicodeDecodeError:
            self.display_window.setPlainText(f"ERROR: This file is not plain text:\n{file_path}")
            self.show_editor_back_button()
            self.speak("This file is not plain text.")
            return
        except OSError as error:
            self.display_window.setPlainText(f"ERROR: Could not open file:\n{error}")
            self.show_editor_back_button()
            self.speak("This file could not be opened.")
            return

        self.active_edit_file_path = file_path
        self.map_list.hide()
        self.file_tree.hide()
        self.display_window.show()
        self.clear_editor_validation_error()
        self.display_window.setPlainText(file_text)
        self.show_editor_back_button()
        self.speak("File loaded for editing.")

