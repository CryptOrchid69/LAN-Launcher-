        if self.restart_pending:
            self.append_display_message("RESTART is currently in progress. Wait for RESTART to finish before using UNINSTALL.")
            self.speak("Restart is currently in progress. Please wait before uninstalling.")
            return

        if not (DAYZ_SERVER_SOURCE_DIR / DAYZ_SERVER_EXE).exists():
            if not DAYZ_SERVER_SOURCE_DIR.exists():
                self.append_display_message("DayZServer is not installed in the default Steam common folder.")
