    def find_running_dayz_server_pids(self):
        try:
            result = subprocess.run(
                [
                    "powershell",
                    "-NoProfile",
                    "-Command",
                    "Get-Process -Name 'DayZServer_x64' -ErrorAction SilentlyContinue | "
                    "Select-Object -ExpandProperty Id",
                ],
                capture_output=True,
                text=True,
                creationflags=subprocess.CREATE_NO_WINDOW,
                timeout=5,
            )
        except (OSError, subprocess.TimeoutExpired):
            return []

        if result.returncode not in (0, 1):
            return []

        return [line.strip() for line in result.stdout.splitlines() if line.strip().isdigit()]

    def stop_dayz_server(self):
        self.map_list.hide()
        self.file_tree.hide()
        self.display_window.show()
        self.display_window.clear()

        if self.launch_worker is not None and self.launch_worker.isRunning():
            self.append_display_message("STOP requested for the active LAN Launcher server.")
            self.launch_worker.request_stop()
            return

        running_server_pids = self.find_running_dayz_server_pids()
        if not running_server_pids:
            self.append_display_message("No DayZServer process is currently running.")
            self.speak("No server is currently running.")
            return

        self.append_display_message("Stopping running DayZServer process(es):")
        self.append_display_message(", ".join(running_server_pids))
        self.speak("Stopping server.")

        stopped_pids = []
        failed_pids = []
        for process_id in running_server_pids:
            if self.stop_dayz_process(process_id):
                stopped_pids.append(process_id)
            else:
                failed_pids.append(process_id)

        if stopped_pids:
            self.append_display_message(f"Stopped DayZServer process ID(s): {', '.join(stopped_pids)}")
            self.speak("Server stopped.")

        if failed_pids:
            self.append_display_message(
                "ERROR: These DayZServer process ID(s) could not be stopped automatically:\n"
                f"{', '.join(failed_pids)}\n\n"
                "Run LAN Launcher as administrator or end DayZServer_x64.exe in Task Manager."
            )
            self.speak("The server could not be stopped automatically. Run LAN Launcher as administrator.")

    def stop_dayz_process(self, process_id):
        try:
            subprocess.run(
                ["taskkill", "/PID", process_id, "/T"],
                capture_output=True,
                text=True,
                creationflags=subprocess.CREATE_NO_WINDOW,
                timeout=8,
            )
        except (OSError, subprocess.TimeoutExpired):
            return False

        if self.wait_for_dayz_process_to_exit(process_id, timeout_seconds=6):
            return True

        if self.wait_for_dayz_process_to_exit(process_id, timeout_seconds=84):
            return True

        try:
            subprocess.run(
                ["taskkill", "/F", "/PID", process_id, "/T"],
                capture_output=True,
                text=True,
                creationflags=subprocess.CREATE_NO_WINDOW,
                timeout=8,
            )
        except (OSError, subprocess.TimeoutExpired):
            return False

        return self.wait_for_dayz_process_to_exit(process_id, timeout_seconds=6)

    def wait_for_dayz_process_to_exit(self, process_id, timeout_seconds):
        deadline = time.monotonic() + timeout_seconds
        while time.monotonic() < deadline:
            if process_id not in self.find_running_dayz_server_pids():
                return True
            time.sleep(0.5)

        return process_id not in self.find_running_dayz_server_pids()

