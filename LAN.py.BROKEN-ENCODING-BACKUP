                f"Saved file count: {saved_count}"
            )
            self.speak(STEAM_ID_SAVE_CONFIRMED_MESSAGE)

    def find_super_admin_files(self):
        profile_roots = []

        for server_layout in SERVER_LAYOUTS:
            profile_roots.append(MANAGED_SERVER_ROOT / server_layout["folder"] / "profiles")

        super_admin_paths = []
        for profile_root in profile_roots:
            if not profile_root.exists() or not profile_root.is_dir():
                continue

            super_admin_path = (
                profile_root
                / "VPPAdminTools"
                / "Permissions"
                / "SuperAdmins"
                / "SuperAdmins.txt"
            )
            if super_admin_path not in super_admin_paths:
                super_admin_paths.append(super_admin_path)

        return super_admin_paths

    def write_steam_id_to_super_admin_file(self, super_admin_path, steam_id):
        existing_lines = []
        if super_admin_path.exists():
            try:
                existing_lines = super_admin_path.read_text(encoding="utf-8").splitlines()
            except OSError as error:
                self.append_display_message(f"ERROR: Could not read SuperAdmins.txt:\n{super_admin_path}\n{error}")
                return False

        if steam_id not in [line.strip() for line in existing_lines]:
            existing_lines.append(steam_id)

        try:
            super_admin_path.parent.mkdir(parents=True, exist_ok=True)
            super_admin_path.write_text("\n".join(existing_lines).rstrip() + "\n", encoding="utf-8")
        except OSError as error:
            self.append_display_message(f"ERROR: Could not save SuperAdmins.txt:\n{super_admin_path}\n{error}")
            return False

        return True

    def get_managed_config_paths(self):
