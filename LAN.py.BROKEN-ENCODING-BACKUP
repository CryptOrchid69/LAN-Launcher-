                self.file_tree.setFocus()
                self.add_primary_dayz_mods_to_tree(root_item)
                root_item.setExpanded(True)
                continue

            if self.active_data_cache_root is not None and root_path == self.active_data_cache_root:
                root_item = QTreeWidgetItem(["DayZ DataCache - select cache.ch"])
                root_item.setData(0, Qt.ItemDataRole.UserRole, str(root_path))
                root_item.setExpanded(True)
                self.file_tree.addTopLevelItem(root_item)
                self.add_directory_to_tree(root_item, root_path)
                self.file_tree.setCurrentItem(root_item)
                root_item.setSelected(True)
                self.file_tree.setFocus()
                continue

            if self.active_dlc_records_root is not None and root_path == self.active_dlc_records_root:
                root_item = QTreeWidgetItem(["Недавние LAN и публичные серверы"])
                root_item.setData(0, Qt.ItemDataRole.UserRole, str(root_path))
                root_item.setChildIndicatorPolicy(QTreeWidgetItem.ChildIndicatorPolicy.ShowIndicator)
