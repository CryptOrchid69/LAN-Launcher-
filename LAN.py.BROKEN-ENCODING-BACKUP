    def handle_steam_id_text_changed(self, text):
        if self.updating_steam_id_input:
            return

        if text.strip() and not self.profile_folder_has_been_generated():
            self.updating_steam_id_input = True
            self.steam_id_input.clear()
            self.updating_steam_id_input = False
            self.show_profile_required_message()
            return

        steam_id = self.extract_steam_id_number(text)
        if not steam_id:
            return

        self.updating_steam_id_input = True
        self.steam_id_input.setText(steam_id)
        self.updating_steam_id_input = False

        if len(steam_id) < STEAM_ID_MIN_LENGTH:
            return

        if not self.dayz_lan_install_is_ready_for_steam_id():
            self.map_list.hide()
            self.file_tree.hide()
            self.display_window.show()
            self.display_window.setPlainText(STEAM_ID_INSTALL_MESSAGE)
            self.speak(STEAM_ID_INSTALL_MESSAGE)
            return

        if steam_id == self.last_saved_steam_id:
            return

        self.save_steam_id_to_super_admins(steam_id)

    def extract_steam_id_number(self, text):
        digit_groups = re.findall(r"\d+", text)
        if not digit_groups:
            return ""

        long_digit_groups = [digits for digits in digit_groups if len(digits) >= STEAM_ID_MIN_LENGTH]
        if long_digit_groups:
            return max(long_digit_groups, key=len)

        return "".join(digit_groups)

    def dayz_lan_install_is_ready_for_steam_id(self):
        return (DAYZ_SERVER_SOURCE_DIR / DAYZ_SERVER_EXE).exists() and MANAGED_SERVER_ROOT.exists()

