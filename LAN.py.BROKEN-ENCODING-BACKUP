            )
            self.speak("All Keys Transferred.")

    def copy_keys_from_mods_folder(self, mods_root):
        copied_count = 0
        scanned_count = 0

        try:
            mod_folders = sorted(
                [path for path in mods_root.iterdir() if path.is_dir() and path.name.startswith("@")],
                key=lambda path: path.name.lower(),
            )
        except OSError as error:
            self.append_display_message(f"ERROR: Could not scan selected MODS folder: {error}")
            return 0, 0

        for mod_folder in mod_folders:
            scanned_count += 1
            copied_count += self.copy_missing_mod_keys(mod_folder)

        return copied_count, scanned_count

    def find_child_folder_case_insensitive(self, parent_folder, child_name):
        exact_folder = parent_folder / child_name
        if exact_folder.exists():
            return exact_folder

        try:
            for child_folder in parent_folder.iterdir():
                if child_folder.is_dir() and child_folder.name.lower() == child_name.lower():
                    return child_folder
        except OSError:
            pass

        return exact_folder

    def copy_missing_mod_keys(self, mod_folder):
        source_keys_dir = self.find_child_folder_case_insensitive(mod_folder, "keys")
        if not source_keys_dir.exists():
            source_keys_dir = self.find_child_folder_case_insensitive(mod_folder, "key")
        if not source_keys_dir.exists():
            self.append_display_message(f"- {mod_folder.name}: no keys folder found.")
            return 0

        destination_keys_dir = DAYZ_SERVER_SOURCE_DIR / "keys"
        try:
            destination_keys_dir.mkdir(exist_ok=True)
        except OSError as error:
            self.append_display_message(f"ERROR: Could not prepare DayZServer keys folder: {error}")
            return 0

        copied_count = 0
        for key_path in source_keys_dir.glob("*.bikey"):
            destination_key_path = destination_keys_dir / key_path.name
            if destination_key_path.exists():
                continue

            try:
                shutil.copy2(key_path, destination_key_path)
                copied_count += 1
            except OSError as error:
                self.append_display_message(f"ERROR: Could not transfer {key_path.name}: {error}")

        if copied_count:
            self.append_display_message(f"- {mod_folder.name}: transferred {copied_count} key file(s).")
        else:
            self.append_display_message(f"- {mod_folder.name}: keys already transferred.")

        return copied_count

