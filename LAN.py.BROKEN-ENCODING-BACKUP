        self.speak("Click install first so LAN Launcher can create the supported map config files.")

    def sanitize_config_value(self, value):
        return value.strip().replace('"', "'")

    def normalize_config_line(self, line):
        return line.replace("\ufeff", "").replace("\u00ef\u00bb\u00bf", "").replace("\u00c3\u00af\u00c2\u00bb\u00c2\u00bf", "").replace("\ufffd", "").lstrip()

    def format_config_identity_lines(self, hostname, password, admin_password):
        hostname_display = hostname if hostname.strip() else "        "
        password_display = password if password.strip() else "        "
        return (
            f'hostname = "{hostname_display}";  // Server name\n'
            f'password = "{password_display}";  // Password to connect to the server\n'
            f'passwordAdmin = "{admin_password}";  // Password to become a server admin'
        )

    def read_config_identity_values(self, config_path):
        values = {
            "hostname": "LAN Launcher",
            "password": "",
            "passwordAdmin": "",
        }

        try:
            config_lines = config_path.read_text(encoding="utf-8").splitlines()
        except OSError:
            return values

        for line in config_lines:
            clean_line = self.normalize_config_line(line)
            match = re.match(r'^\s*(hostname|password|passwordAdmin)\s*=\s*"([^"]*)"', clean_line)
            if match:
                values[match.group(1)] = match.group(2)

        return values

    def extract_identity_values_from_display(self):
        values = {}
        for line in self.display_window.toPlainText().splitlines():
            clean_line = self.normalize_config_line(line)
            match = re.match(r'^\s*(hostname|password|passwordAdmin)\s*=\s*"([^"]*)"', clean_line)
            if match:
                values[match.group(1)] = self.sanitize_config_value(match.group(2))

        required_keys = {"hostname", "password", "passwordAdmin"}
        if set(values) != required_keys:
            return None

        return values

    def update_config_identity_values(self, config_path, values):
        try:
            config_lines = config_path.read_text(encoding="utf-8").splitlines()
        except OSError as error:
            self.append_display_message(f"ERROR: Could not read config file:\n{config_path}\n{error}")
            return False

        replacements = {
            "hostname": f'hostname = "{values["hostname"]}";  // Server name',
            "password": f'password = "{values["password"]}";  // Password to connect to the server',
            "passwordAdmin": f'passwordAdmin = "{values["passwordAdmin"]}";  // Password to become a server admin',
        }
        found_keys = set()
        updated_lines = []

        for line in config_lines:
            clean_line = self.normalize_config_line(line)
            key = clean_line.split("=", 1)[0].strip() if "=" in clean_line else ""
            if key in replacements:
                if key not in found_keys:
                    updated_lines.append(replacements[key])
                    found_keys.add(key)
                continue

            updated_lines.append(line)

        missing_lines = [replacements[key] for key in ("hostname", "password", "passwordAdmin") if key not in found_keys]
        if missing_lines:
            updated_lines = missing_lines + updated_lines

        try:
            config_path.write_text("\n".join(updated_lines).rstrip() + "\n", encoding="utf-8")
        except OSError as error:
            self.append_display_message(f"ERROR: Could not save config file:\n{config_path}\n{error}")
            return False

        return True

    def save_admin_password_setup(self):
