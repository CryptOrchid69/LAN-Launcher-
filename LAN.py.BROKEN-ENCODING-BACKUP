    def speak(self, text):
        text = self.russian_voice_text(text)
        if not self.voice_enabled:
            return

        if self.speech_worker is not None and self.speech_worker.isRunning():
            self.speech_queue.append(text)
            return

        worker = SpeechWorker(text)
        self.speech_worker = worker
        worker.finished.connect(self.speak_next_message)
        worker.finished.connect(worker.deleteLater)
        worker.start()

    def speak_next_message(self):
        finished_worker = self.sender()
        if finished_worker is self.speech_worker:
            self.speech_worker = None

        if not self.voice_enabled or not self.speech_queue:
            return

        next_text = self.speech_queue.pop(0)
        worker = SpeechWorker(next_text)
        self.speech_worker = worker
        worker.finished.connect(self.speak_next_message)
        worker.finished.connect(worker.deleteLater)
        worker.start()

