    def prepare_dayz_client_display_config(self):
        if not DAYZ_CLIENT_CONFIG.exists():
            return

        try:
            config_text = DAYZ_CLIENT_CONFIG.read_text(encoding="utf-8", errors="ignore")
        except OSError as error:
            self.append_display_message(f"DayZ display settings could not be checked: {error}")
            return

        replacements = {
            "Windowed": "1",
            "WindowWidth": "1920",
            "WindowHeight": "1080",
        }
        changed = False
        for setting_name, setting_value in replacements.items():
            pattern = re.compile(rf"^{setting_name}=.*?;$", re.MULTILINE)
            replacement = f"{setting_name}={setting_value};"
            config_text, count = pattern.subn(replacement, config_text)
            if count:
                changed = True
            else:
                config_text += f"\n{replacement}"
                changed = True

        if not changed:
            return

        try:
            DAYZ_CLIENT_CONFIG.write_text(config_text, encoding="utf-8")
            self.append_display_message("DayZ client display settings prepared for windowed 1920x1080 launch.")
        except OSError as error:
            self.append_display_message(f"DayZ display settings could not be saved: {error}")

