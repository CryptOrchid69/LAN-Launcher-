    def sync_map_mod_list(self, mods_dir):
        mod_list_path = mods_dir / "mod_list.txt"
        if not mods_dir.exists():
            return

        existing_lines = []
        if mod_list_path.exists():
            try:
                existing_lines = mod_list_path.read_text(encoding="utf-8").splitlines()
            except OSError as error:
                self.append_display_message(f"Could not read map mod list: {error}")
                return

        mod_lines = []
        comment_lines = []
        for raw_line in existing_lines:
            line = raw_line.strip().lstrip("\ufeff")
            if not line:
                continue
            if line.startswith("@"):
                if line not in mod_lines:
                    mod_lines.append(line)
            elif line != "# No required map Workshop mods listed for this vanilla map.":
                comment_lines.append(raw_line)

        try:
            local_mod_folders = sorted(
                [path for path in mods_dir.iterdir() if path.is_dir() and path.name.startswith("@")],
                key=lambda path: path.name.lower(),
            )
        except OSError as error:
            self.append_display_message(f"Could not scan map mod folder: {error}")
            return

        for local_mod_folder in local_mod_folders:
            if local_mod_folder.name not in mod_lines:
                mod_lines.append(local_mod_folder.name)

        if not mod_lines and not comment_lines:
            comment_lines = ["# No required map Workshop mods listed for this vanilla map."]

        new_lines = mod_lines + comment_lines
        try:
            mod_list_path.write_text("\n".join(new_lines) + "\n", encoding="utf-8")
        except OSError as error:
            self.append_display_message(f"Could not update map mod list: {error}")

