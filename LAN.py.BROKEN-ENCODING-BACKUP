                f"ПРЕДУПРЕЖДЕНИЕ: пароль администратора сохранен в {credentials_saved_count} из {len(SERVER_LAYOUTS)} файлов credentials."
            )

        self.admin_config_edit_mode = True
        self.map_list.hide()
        self.file_tree.hide()
        self.display_window.show()
        self.display_window.setPlainText(
            self.format_config_identity_lines(
