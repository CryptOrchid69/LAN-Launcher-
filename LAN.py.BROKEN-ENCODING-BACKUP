class MPMissionsTreeWidget(QTreeWidget):
    files_dropped = pyqtSignal(list, object)
    copy_requested = pyqtSignal(object)
    paste_requested = pyqtSignal(object)
    return_requested = pyqtSignal(object)

    def __init__(self):
        super().__init__()
        self.setAcceptDrops(True)
        self.setDragDropMode(QTreeWidget.DragDropMode.DropOnly)
        self.setDefaultDropAction(Qt.DropAction.CopyAction)

    def dragEnterEvent(self, event):
        if self.event_has_local_files(event):
            event.acceptProposedAction()
            return

        super().dragEnterEvent(event)

    def dragMoveEvent(self, event):
        if self.event_has_local_files(event):
            event.acceptProposedAction()
            return

        super().dragMoveEvent(event)

    def dropEvent(self, event):
        if not self.event_has_local_files(event):
            super().dropEvent(event)
            return

        target_item = self.itemAt(event.position().toPoint())
        files = self.local_files_from_event(event)
        self.files_dropped.emit(files, target_item)
        event.acceptProposedAction()

    def contextMenuEvent(self, event):
        menu = QMenu(self)
        copy_action = menu.addAction("Copy")
        paste_action = menu.addAction("Paste")
        selected_action = menu.exec(event.globalPos())
        if selected_action == copy_action:
            self.copy_requested.emit(self.itemAt(event.pos()))
            return

        if selected_action == paste_action:
            self.paste_requested.emit(self.itemAt(event.pos()))
            return

        super().contextMenuEvent(event)

    def keyPressEvent(self, event):
        if event.matches(QKeySequence.StandardKey.Paste):
            self.paste_requested.emit(self.currentItem())
            return

        if event.key() in (Qt.Key.Key_Return, Qt.Key.Key_Enter):
            self.return_requested.emit(self.currentItem())
            return

        super().keyPressEvent(event)

    def event_has_local_files(self, event):
        return bool(self.local_files_from_event(event))

    def local_files_from_event(self, event):
        mime_data = event.mimeData()
        if not mime_data.hasUrls():
            return []

        files = []
        for url in mime_data.urls():
            if url.isLocalFile():
                file_path = Path(url.toLocalFile())
                if file_path.is_file() or file_path.is_dir():
                    files.append(file_path)

        return files


