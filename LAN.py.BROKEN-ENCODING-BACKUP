        files = self.get_qt_clipboard_file_paths()
        if files:
            return files

        return self.get_windows_clipboard_file_paths()

    def get_qt_clipboard_file_paths(self):
        clipboard = QApplication.clipboard()
        mime_data = clipboard.mimeData()
        if not mime_data.hasUrls():
            return []

        files = []
        for url in mime_data.urls():
            if url.isLocalFile():
                file_path = Path(url.toLocalFile())
                if file_path.is_file() or file_path.is_dir():
                    files.append(file_path)

        return files

    def get_windows_clipboard_file_paths(self):
        files = []
        try:
            win32clipboard.OpenClipboard()
            if not win32clipboard.IsClipboardFormatAvailable(win32clipboard.CF_HDROP):
                return []

            copied_files = win32clipboard.GetClipboardData(win32clipboard.CF_HDROP)
        except Exception:
            return []
        finally:
            try:
                win32clipboard.CloseClipboard()
            except Exception:
                pass

        for copied_file in copied_files:
            file_path = Path(copied_file)
            if file_path.is_file() or file_path.is_dir():
                files.append(file_path)

        return files

