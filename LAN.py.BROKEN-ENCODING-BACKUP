class UninstallWorker(QThread):
    log_signal = pyqtSignal(str)
    speak_signal = pyqtSignal(str)
    finished_signal = pyqtSignal(bool)

    def run(self):
        uninstall_completed = False
        try:
            uninstall_completed = self.finish_dayz_server_uninstall()
        except OSError as error:
            self.log(f"ERROR: Windows blocked the UNINSTALL cleanup: {error}")
            self.log("Run LAN Launcher as administrator and try UNINSTALL again.")
        finally:
            self.finished_signal.emit(uninstall_completed)

    def log(self, message):
        self.log_signal.emit(message)

    def speak(self, message):
        self.speak_signal.emit(message)

    def finish_dayz_server_uninstall(self):
        self.log("Waiting for Steam to finish uninstalling DayZServer.")
        waited_seconds = 0
        while waited_seconds < UNINSTALL_WAIT_SECONDS:
            if not DAYZ_SERVER_APP_MANIFEST.exists():
                self.log("Steam uninstall record removed.")
                return self.recycle_leftover_dayz_server_folder()

            time.sleep(UNINSTALL_POLL_SECONDS)
            waited_seconds += UNINSTALL_POLL_SECONDS
            if waited_seconds % 60 == 0:
                waited_minutes = waited_seconds // 60
                self.log(f"Still waiting for Steam to uninstall DayZServer... {waited_minutes} minute(s).")

        self.log("ERROR: Steam did not finish uninstalling DayZServer before the wait time ended.")
        return False

    def recycle_leftover_dayz_server_folder(self):
        if not DAYZ_SERVER_SOURCE_DIR.exists():
            self.log("DayZServer folder was removed by Steam.")
            return True

        self.log("Leftover DayZServer folder found after Steam uninstall.")
        self.log("Moving leftover DayZServer folder to the Recycle Bin.")
        move_file_to_recycle_bin(DAYZ_SERVER_SOURCE_DIR)

        if DAYZ_SERVER_SOURCE_DIR.exists():
            self.log("ERROR: DayZServer folder is still present after recycle-bin cleanup.")
            return False

        self.log("Leftover DayZServer folder moved to the Recycle Bin.")
        return True


class SpeechWorker(QThread):
    def __init__(self, text):
        super().__init__()
        self.text = self.prepare_spoken_text(text)
        self.stop_requested = False

    def prepare_spoken_text(self, text):
        spoken_lines = []
        for line in str(text).splitlines():
            stripped_line = line.strip()
            if not stripped_line:
                spoken_lines.append("")
                continue

            if re.fullmatch(r"[=\-_*#~]{4,}", stripped_line):
                continue

            cleaned_line = re.sub(r"[=\-_*#~]{4,}", " ", line)
            cleaned_line = re.sub(r"\s{2,}", " ", cleaned_line).strip()
            if cleaned_line:
                spoken_lines.append(cleaned_line)

        return "\n".join(spoken_lines).strip()

    def stop(self):
        self.stop_requested = True

    def run(self):
        if not self.text:
            return

        try:
            pythoncom.CoInitialize()
            voice = win32com.client.Dispatch("SAPI.SpVoice")
            self.configure_voice(voice)
            voice.Speak(self.text, 1)
            while not self.stop_requested and not voice.WaitUntilDone(100):
                pass
            if self.stop_requested:
                voice.Speak("", 2)
        except Exception:
            pass
        finally:
            try:
                pythoncom.CoUninitialize()
            except Exception:
                pass

    def configure_voice(self, voice):
        voice.Volume = 90
        voice.Rate = -1

        for sapi_voice in voice.GetVoices():
            description = sapi_voice.GetDescription().lower()
            if "zira" in description or "female" in description:
                voice.Voice = sapi_voice
                break


class ServerLaunchWorker(QThread):
    log_signal = pyqtSignal(str)
    speak_signal = pyqtSignal(str)
    finished_signal = pyqtSignal()

    def __init__(self, server_layout):
        super().__init__()
        self.server_layout = server_layout
        self.server_process = None
        self.server_started_at = None
        self.stop_requested = False
        self.stop_requested_at = None
        self.graceful_stop_signal_sent = False

    def run(self):
        try:
            self.launch_selected_server()
        except OSError as error:
            self.log(f"ERROR: Could not launch server: {error}")
            self.speak("Error. The selected server could not be started.")
            write_diagnostic_log("Server launch OSError", traceback.format_exc())
        except Exception as error:
            details = traceback.format_exc()
            write_diagnostic_log("Server launch exception", details)
            self.log(f"ERROR: LAN Launcher hit an internal launch error:\n{error}")
            self.log(f"A diagnostic report was written to:\n{APP_DIAGNOSTIC_LOG}")
            self.speak("Error. LAN Launcher hit an internal launch error.")
        finally:
            self.finished_signal.emit()

    def log(self, message):
        self.log_signal.emit(message)

    def speak(self, message):
        self.speak_signal.emit(message)

    def request_restart_stop(self):
        self.stop_requested = True
        self.stop_requested_at = time.monotonic()
        self.log(f"Stopping {self.server_layout['map_name']} for restart...")
        self.speak("Restarting server.")
        self.request_graceful_server_stop()

    def request_stop(self):
        self.stop_requested = True
        self.stop_requested_at = time.monotonic()
        self.log(f"Stopping {self.server_layout['map_name']}...")
        self.speak("Stopping server.")
        self.request_graceful_server_stop()

    def request_graceful_server_stop(self):
        if self.server_process is None or self.server_process.poll() is not None:
            return

        try:
            self.log("Graceful shutdown requested. Waiting for DayZServer to save persistence data.")
            self.server_process.send_signal(signal.CTRL_BREAK_EVENT)
            self.graceful_stop_signal_sent = True
        except OSError as error:
            self.log(f"ERROR: Could not request graceful server shutdown: {error}")
            self.log("Windows rejected the graceful stop signal. LAN Launcher will use the fallback stop after a short save window.")

    def launch_selected_server(self):
        exe_path = DAYZ_SERVER_SOURCE_DIR / DAYZ_SERVER_EXE
        if not exe_path.exists():
            self.log("ERROR: DayZ Server is not installed yet.")
            self.speak("Day Zee Server is not installed yet.")
            return

        if not self.required_dlc_is_available():
            return

        if not self.required_workshop_mods_are_available():
            return

        profile_root = MANAGED_SERVER_ROOT / self.server_layout["folder"]
        config_path = profile_root / "config" / self.server_layout["config"]
        profiles_path = profile_root / "profiles"
        battleye_path = DAYZ_SERVER_SOURCE_DIR / "battleye"

        self.prepare_launch_layout(profile_root, config_path, profiles_path)
        self.prepare_deerisle_profile_configs(profiles_path)

        for required_path in (config_path, profiles_path, battleye_path):
            if not required_path.exists():
                self.log(f"ERROR: Required launch path is missing: {required_path}")
                self.speak("A required server folder or file is missing.")
                return

        first_profile_run = self.folder_is_empty(profiles_path)
        command = self.build_launch_command(exe_path, config_path, profiles_path, battleye_path)

        self.log(f"Launching {self.server_layout['map_name']}...")
        self.speak("Starting server.")

        if first_profile_run:
            self.log_first_profile_instructions()
            self.speak(
                "Alert. Please wait for a moment and let the game run until the profile folder is deposited "
                "into the DayZ Server folder."
            )

        self.server_started_at = time.time()
        self.server_process = subprocess.Popen(
            command,
            cwd=DAYZ_SERVER_SOURCE_DIR,
            creationflags=subprocess.CREATE_NEW_CONSOLE | subprocess.CREATE_NEW_PROCESS_GROUP,
        )

        if first_profile_run:
            self.wait_for_profile_deposit(profiles_path)

        self.watch_server(profiles_path)

    def required_dlc_is_available(self):
        required_dlc = self.server_layout.get("required_dlc")
        if not required_dlc:
            return True

        mission_template = self.server_layout["mission_template"]
        mission_path = DAYZ_SERVER_SOURCE_DIR / "mpmissions" / mission_template
        dlc_appid = required_dlc.get("appid", "")

        if dlc_appid and self.steam_dlc_is_installed(dlc_appid) and mission_path.exists():
            return True

        if not dlc_appid and mission_path.exists():
            return True

        if required_dlc.get("future_release"):
            self.log(
                f"ERROR: {self.server_layout['map_name']} is prepared as a future DLC map, "
                "but the official mission folder was not found yet."
            )
            self.log(
                "After Badlands is released and purchased through Steam, install the DLC, "
                "then click INSTALL again so LAN Launcher can place the mission files."
            )
            self.speak(
                "Badlands is a future Day Zee DLC map. Purchase and install the Badlands DLC through Steam, then click INSTALL again."
            )
            return False

        self.log(
            f"ERROR: {self.server_layout['map_name']} requires {required_dlc['name']}, "
            "but the required DLC or mission files were not detected."
        )
        self.speak("You must have the DLC for those maps.")
        return False

    def required_workshop_mods_are_available(self):
        missing_mods = []
        for mod_name in self.server_layout["workshop_mods"]:
            if not mod_name.startswith("@"):
                continue

            shared_mod_folder = DAYZ_SERVER_SOURCE_DIR / mod_name
            local_mod_folder = MANAGED_SERVER_ROOT / self.server_layout["folder"] / "mods" / mod_name
            if shared_mod_folder.exists() or local_mod_folder.exists():
                continue

            if self.install_known_workshop_mod_from_cache(mod_name):
                continue

            missing_mods.append(mod_name)

        if not missing_mods:
            return True

        self.log(f"ERROR: {self.server_layout['map_name']} is missing required Workshop mod folder(s):")
        for missing_mod in missing_mods:
            self.log(f"- {missing_mod}")
            self.open_missing_workshop_mod(missing_mod)

        self.speak("A required Workshop mod is missing. Please subscribe to it in Steam, let it download, then click LAUNCH again.")
        return False

    def prepare_launch_layout(self, profile_root, config_path, profiles_path):
        profiles_need_template = not profiles_path.exists() or self.folder_is_empty(profiles_path)
        for folder_path in (profile_root, config_path.parent, profiles_path, profile_root / "keys", profile_root / "mods"):
            folder_path.mkdir(parents=True, exist_ok=True)

        if profiles_need_template:
            self.copy_profile_template(profiles_path)

        if not config_path.exists():
            config_template = self.find_config_template_source()
            if config_template is not None:
                shutil.copy2(config_template, config_path)
                self.log(f"Prepared missing config for {self.server_layout['map_name']}: {config_path.name}")

    def copy_profile_template(self, profiles_path):
        if not PROFILE_TEMPLATE_DIR.exists():
            self.log(f"{self.server_layout['map_name']}: profile template was not found yet.")
            return

        copied_profile_folders = 0
        for folder_name in PROFILE_TEMPLATE_COPY_FOLDERS:
            source_folder = PROFILE_TEMPLATE_DIR / folder_name
            if not source_folder.exists() or not source_folder.is_dir():
                continue

            shutil.copytree(source_folder, profiles_path / folder_name, dirs_exist_ok=True)
            copied_profile_folders += 1

        if copied_profile_folders:
            self.log(f"{self.server_layout['map_name']}: clean profile template prepared.")


    def find_config_template_source(self):
        possible_sources = (
            APP_DIR / "CONFIGS" / self.server_layout["config"],
            APP_DIR / "configs" / self.server_layout["config"],
            RESOURCE_DIR / "CONFIGS" / self.server_layout["config"],
            RESOURCE_DIR / "configs" / self.server_layout["config"],
            PRACTICE_DAYZ_SERVER_DIR / "config" / self.server_layout["config"],
        )

        for possible_source in possible_sources:
            if possible_source.exists() and possible_source.is_file():
                return possible_source

        return None

    def prepare_deerisle_profile_configs(self, profiles_path):
        if self.server_layout["folder"] != "DayZServerDEERISLE":
            return

        config_path = profiles_path / "Deerisle" / "DivingLootConfig.json"
        if not config_path.exists():
            return

        unstable_items = {
            "BakedBeansCan",
            "Canteen",
            "PowderedMilk",
            "Rice",
            "SardinesCan",
            "SpaghettiCan",
            "TunaCan",
        }

        try:
            config_data = json.loads(config_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError) as error:
            self.log(f"WARNING: Could not inspect DeerIsle diving loot config: {error}")
            return

        normal_loot = config_data.get("divingLootListNormal")
        if not isinstance(normal_loot, list):
            return

        cleaned_loot = [item for item in normal_loot if item not in unstable_items]
        if len(cleaned_loot) == len(normal_loot):
            return

        config_data["divingLootListNormal"] = cleaned_loot
        try:
            config_path.write_text(json.dumps(config_data, indent=4), encoding="utf-8")
            self.log("DeerIsle diving loot config cleaned to avoid unstable food and drink item crashes.")
        except OSError as error:
            self.log(f"WARNING: Could not save cleaned DeerIsle diving loot config: {error}")

    def install_known_workshop_mod_from_cache(self, mod_name):
        for mod_info in KNOWN_WORKSHOP_MODS:
            if mod_info["folder"] != mod_name:
                continue

            workshop_source = self.get_workshop_mod_source(mod_info)
            if not workshop_source.exists():
                workshop_source = self.get_bundled_mod_source(mod_info)
            if workshop_source is None or not workshop_source.exists():
                return False

            mod_folder = DAYZ_SERVER_SOURCE_DIR / mod_info["folder"]
            self.log(f"{mod_info['folder']} was found in Steam Workshop downloads or the LAN Launcher app folder.")
            self.log(f"Installing {mod_info['folder']} into DayZServer before launch.")
            shutil.copytree(workshop_source, mod_folder, dirs_exist_ok=True)
            copied_count = self.copy_mod_keys(mod_folder)
            if copied_count:
                self.log(f"{mod_info['folder']} key file(s) deposited into the DayZServer keys folder.")
            return True

        return False
    def copy_mod_keys(self, mod_folder):
        source_keys_dir = self.find_child_folder_case_insensitive(mod_folder, "keys")
        if not source_keys_dir.exists():
            source_keys_dir = self.find_child_folder_case_insensitive(mod_folder, "key")
        if not source_keys_dir.exists():
            return 0

        destination_keys_dir = DAYZ_SERVER_SOURCE_DIR / "keys"
        destination_keys_dir.mkdir(exist_ok=True)

        copied_count = 0
        for key_path in source_keys_dir.glob("*.bikey"):
            shutil.copy2(key_path, destination_keys_dir / key_path.name)
            copied_count += 1

        if copied_count:
            self.log(f"Copied {copied_count} key file(s) from {mod_folder.name}.")

        return copied_count

    def find_child_folder_case_insensitive(self, parent_folder, child_name):
        exact_folder = parent_folder / child_name
        if exact_folder.exists():
            return exact_folder

        try:
            for child_folder in parent_folder.iterdir():
                if child_folder.is_dir() and child_folder.name.lower() == child_name.lower():
                    return child_folder
        except OSError:
            pass

        return exact_folder

    def get_workshop_mod_source(self, mod_info):
        return STEAM_WORKSHOP_CONTENT_DIR / mod_info["workshop_id"]

    def get_bundled_mod_source(self, mod_info):
        for source_root in (APP_DIR, RESOURCE_DIR, APP_DIR.parent, PRACTICE_DAYZ_SERVER_DIR):
            mod_source = source_root / mod_info["folder"]
            if mod_source.exists() and mod_source.is_dir():
                return mod_source
        return None
    def open_missing_workshop_mod(self, missing_mod):
        for mod_info in KNOWN_WORKSHOP_MODS:
            if mod_info["folder"] == missing_mod:
                steam_page_uri = f"steam://url/CommunityFilePage/{mod_info['workshop_id']}"
                try:
                    os.startfile(steam_page_uri)
                    self.log(f"Opened Steam Workshop page for {mod_info['name']}.")
                except OSError:
                    self.log(f"Workshop page: {mod_info['workshop_url']}")
                return

        self.log(f"No verified Workshop page is configured for {missing_mod}.")

    def steam_dlc_is_installed(self, dlc_appid):
        steamapps_dir = STEAM_COMMON_DIR.parent
        dlc_manifest = steamapps_dir / f"appmanifest_{dlc_appid}.acf"
        if dlc_manifest.exists():
            return True

        dayz_manifest = steamapps_dir / f"appmanifest_{DAYZ_WORKSHOP_APP_ID}.acf"
        if self.acf_mentions_dlc_appid(dayz_manifest, dlc_appid):
            return True

        return False

    def acf_mentions_dlc_appid(self, manifest_path, dlc_appid):
        if not manifest_path.exists():
            return False

        try:
            manifest_text = manifest_path.read_text(encoding="utf-8", errors="ignore")
        except OSError:
            return False

        return f'"dlcappid"\t\t"{dlc_appid}"' in manifest_text or f'"{dlc_appid}"' in manifest_text

    def build_launch_command(self, exe_path, config_path, profiles_path, battleye_path):
        command = [
            str(exe_path),
            f"-config={config_path}",
            f"-port={SERVER_PORT}",
            f"-cpuCount={SERVER_CPU_COUNT}",
            "-freezecheck",
            f"-BEpath={battleye_path}",
            f"-profiles={profiles_path}",
        ]

        mod_argument = self.read_mod_argument()
        if mod_argument:
            command.append(f"-mod={mod_argument}")
        elif self.server_layout["workshop_mods"]:
            self.log(
                f"WARNING: {self.server_layout['map_name']} may require Workshop map mods, "
                "but no @mod folder names are listed yet."
            )

        return command

    def read_mod_argument(self):
        mod_list_path = MANAGED_SERVER_ROOT / self.server_layout["folder"] / "mods" / "mod_list.txt"
        if not mod_list_path.exists():
            return ""

        mod_arguments = []
        mod_list_dir = mod_list_path.parent
        for raw_line in mod_list_path.read_text(encoding="utf-8").splitlines():
            line = raw_line.strip().lstrip("\ufeff")
            if line.startswith("@"):
                self.add_mod_argument(mod_arguments, line, mod_list_dir)

        try:
            local_mod_folders = sorted(
                [path for path in mod_list_dir.iterdir() if path.is_dir() and path.name.startswith("@")],
                key=lambda path: path.name.lower(),
            )
        except OSError:
            local_mod_folders = []

        for local_mod_folder in local_mod_folders:
            self.add_mod_argument(mod_arguments, local_mod_folder.name, mod_list_dir)

        return ";".join(mod_arguments)

    def add_mod_argument(self, mod_arguments, mod_name, mod_list_dir):
        mod_argument = self.resolve_mod_argument(mod_name, mod_list_dir)
        if mod_argument and mod_argument not in mod_arguments:
            mod_arguments.append(mod_argument)

    def resolve_mod_argument(self, mod_name, mod_list_dir):
        shared_mod_folder = DAYZ_SERVER_SOURCE_DIR / mod_name
        if shared_mod_folder.exists():
            return mod_name

        local_mod_folder = mod_list_dir / mod_name
        if local_mod_folder.exists():
            return str(local_mod_folder)

        return mod_name

    def open_steam_library(self):
        try:
            os.startfile(STEAM_LIBRARY_URI)
        except OSError:
            self.log("Steam could not be opened automatically, but the server launch will continue.")

    def folder_is_empty(self, folder_path):
        return not any(folder_path.iterdir())

    def log_first_profile_instructions(self):
        instructions = (
            "FIRST TIME SERVER PROFILE SETUP\n\n"
            "Alert. Please wait for a moment and let the game run until the Profile folder is deposited "
            "into the DayZServer folder.\n\n"
            "After the Profile folder appears, go into your Steam account. Click your user name next to "
            "the COMMUNITY tab, then left click the link directly below it that has your Steam ID number.\n\n"
            "Place only the Steam ID number into the STEAM ID space at the top of this app, then click ENTER "
            "to save it.\n\n"
            "Теперь выберите пароль администратора. Введите пароль в поле Пароль администратора."
        )
        self.log(instructions)

    def wait_for_profile_deposit(self, profiles_path):
        for _ in range(180):
            if self.server_process.poll() is not None:
                return

            if not self.folder_is_empty(profiles_path):
                self.replicate_profile_folder_to_managed_maps(profiles_path)
                self.log(PROFILE_GENERATED_MESSAGE)
                self.speak(PROFILE_GENERATED_MESSAGE)
                return

            time.sleep(1)

        self.log("Profile folder was not detected within 3 minutes. Keep the server running and check again.")

    def replicate_profile_folder_to_managed_maps(self, source_profiles_path):
        template_profiles_path = PROFILE_TEMPLATE_DIR if PROFILE_TEMPLATE_DIR.exists() else source_profiles_path
        replicated_count = 0

        for server_layout in SERVER_LAYOUTS:
            target_profiles_path = MANAGED_SERVER_ROOT / server_layout["folder"] / "profiles"
            if target_profiles_path == template_profiles_path:
                continue

            try:
                target_profiles_path.parent.mkdir(parents=True, exist_ok=True)
                if target_profiles_path.exists() and not self.folder_is_empty(target_profiles_path):
                    continue

                target_profiles_path.mkdir(exist_ok=True)
                copied_profile_folders = 0
                for folder_name in PROFILE_TEMPLATE_COPY_FOLDERS:
                    source_folder = template_profiles_path / folder_name
                    if not source_folder.exists() or not source_folder.is_dir():
                        continue

                    shutil.copytree(source_folder, target_profiles_path / folder_name, dirs_exist_ok=True)
                    copied_profile_folders += 1

                if copied_profile_folders == 0:
                    continue

                replicated_count += 1
            except OSError as error:
                self.log(f"ERROR: Could not prepare profiles folder for {server_layout['map_name']}: {error}")

        if replicated_count:
            self.log(f"Profiles folder replicated into {replicated_count} additional map folders.")

    def watch_server(self, profiles_path):
        if self.server_process is None:
            return

        while self.server_process.poll() is None:
            if self.stop_requested and self.stop_requested_at is not None:
                save_window_seconds = 90 if self.graceful_stop_signal_sent else 15
                if time.monotonic() - self.stop_requested_at > save_window_seconds:
                    self.log("Server did not close after the persistence save window. Stopping DayZServer now.")
                    try:
                        self.server_process.terminate()
                        self.server_process.wait(timeout=10)
                    except (OSError, subprocess.TimeoutExpired) as error:
                        self.log(f"ERROR: Normal fallback stop did not complete cleanly: {error}")
                        try:
                            self.server_process.kill()
                            self.server_process.wait(timeout=10)
                        except (OSError, subprocess.TimeoutExpired) as kill_error:
                            self.log(f"ERROR: Forced shutdown did not complete cleanly: {kill_error}")
                    break

            time.sleep(1)

        exit_code = self.server_process.returncode
        if self.stop_requested:
            self.log("Server stopped.")
            return

        if exit_code == 0:
            self.log("Server closed normally.")
            return

        recent_crash_logs = self.find_recent_crash_logs(profiles_path)
        if not recent_crash_logs:
            self.log(f"Server closed with exit code {exit_code}. No new crash or error logs were detected.")
            return

        self.log(f"WARNING: Server closed unexpectedly with exit code {exit_code}.")
        self.speak("Warning. Server side instability detected. The server has closed unexpectedly.")
        self.report_possible_crash_causes(profiles_path)

    def find_recent_crash_logs(self, profiles_path):
        if self.server_started_at is None:
            return []

        recent_logs = []
        for pattern in ("crash_*.log", "error_*.log"):
            for log_path in profiles_path.glob(pattern):
                try:
                    if log_path.stat().st_mtime >= self.server_started_at:
                        recent_logs.append(log_path)
                except OSError:
                    continue

        return recent_logs

    def report_possible_crash_causes(self, profiles_path):
        log_files = []
        for pattern in ("crash_*.log", "error_*.log", "script_*.log", "*.RPT"):
            log_files.extend(profiles_path.glob(pattern))

        if not log_files:
            self.log("No crash, error, script, or RPT logs were found in this profile folder yet.")
            return

        latest_logs = sorted(log_files, key=lambda path: path.stat().st_mtime, reverse=True)[:5]
        self.log("Possible crash clues from latest logs:")
        for log_path in latest_logs:
            self.log(f"- {log_path.name}")


