    def build_mods_browser_roots(self, server_layout, mods_dir):
        roots = [("MAP MODS DROP", mods_dir)]
        mod_names = [mod_info["folder"] for mod_info in REQUIRED_BASE_MODS]
        mod_names.extend(mod_name for mod_name in server_layout.get("workshop_mods", ()) if mod_name.startswith("@"))

        seen_mods = set()
        for mod_name in mod_names:
            if mod_name in seen_mods:
                continue

            seen_mods.add(mod_name)
            shared_mod_folder = DAYZ_SERVER_SOURCE_DIR / mod_name
            if shared_mod_folder.exists() and shared_mod_folder.is_dir():
                roots.append(("ACTIVE MOD", shared_mod_folder))

        try:
            local_mod_folders = sorted(
                [path for path in mods_dir.iterdir() if path.is_dir() and path.name.startswith("@")],
                key=lambda path: path.name.lower(),
            )
        except OSError:
            local_mod_folders = []

        for local_mod_folder in local_mod_folders:
            if local_mod_folder.name in seen_mods:
                continue

            seen_mods.add(local_mod_folder.name)
            roots.append(("ACTIVE MOD", local_mod_folder))

        return roots

