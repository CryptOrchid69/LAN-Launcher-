            else:
                preserved_lines = ["# No required map Workshop mods listed for this vanilla map."]

        mod_lines = required_lines + preserved_lines
        mod_list_path.write_text("\n".join(mod_lines) + "\n", encoding="utf-8")

    def write_config_placeholder(self, server_layout, config_dir):
