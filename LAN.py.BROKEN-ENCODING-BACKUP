            for server_layout in SERVER_LAYOUTS:
                profile_roots.append(MANAGED_SERVER_ROOT / server_layout["folder"] / "profiles")

        profile_roots.append(DAYZ_SERVER_SOURCE_DIR / "profiles")

        for profile_root in profile_roots:
            if not profile_root.exists() or not profile_root.is_dir():
