    def save_steam_id_to_super_admins(self, steam_id):
        super_admin_paths = self.find_super_admin_files()
        if not super_admin_paths:
            self.map_list.hide()
            self.file_tree.hide()
            self.display_window.show()
            self.display_window.setPlainText(
                "VPPAdminTools SuperAdmins.txt was not found yet.\n\n"
