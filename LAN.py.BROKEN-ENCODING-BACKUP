    def validate_editor_file_text(self, file_path, file_text):
        suffix = Path(file_path).suffix.lower()
        if suffix == ".xml":
            return self.validate_xml_editor_text(file_path, file_text)
        if suffix == ".json":
            return self.validate_json_editor_text(file_text)
        if suffix == ".cfg":
            return self.validate_cfg_editor_text(file_text)
        if suffix in {".c", ".cpp"}:
            return self.validate_script_editor_text(file_text)
        return None

    def validate_xml_editor_text(self, file_path, file_text):
        stripped_text = file_text.lstrip("\ufeff\r\n\t ")
        leading_column = len(file_text) - len(stripped_text)
        if stripped_text and not stripped_text.startswith("<"):
            return {
                "line": 1,
                "column": leading_column,
                "message": "XML content must begin with an opening tag.",
            }

        try:
            ET.fromstring(file_text)
        except ET.ParseError as error:
            line_number, column_number = getattr(error, "position", (1, 0))
            return {
                "line": max(line_number, 1),
                "column": max(column_number, 0),
                "message": str(error),
            }
        dayz_text_error = self.validate_dayz_xml_text_nodes(file_text)
        if dayz_text_error:
            return dayz_text_error
        dayz_attribute_error = self.validate_dayz_xml_attributes(file_text)
        if dayz_attribute_error:
            return dayz_attribute_error
        dayz_classname_error = self.validate_dayz_xml_classnames(file_path, file_text)
        if dayz_classname_error:
            return dayz_classname_error
        return None

    def validate_dayz_xml_text_nodes(self, file_text):
        opening_tag_pattern = re.compile(r"<([A-Za-z_][\w:.-]*)(?:\s[^<>]*)?>([^<\r\n]+)")

        for line_number, line_text in enumerate(file_text.splitlines(), start=1):
            for match in opening_tag_pattern.finditer(line_text):
                tag_name = match.group(1)
                raw_text = match.group(2)
                remaining_line = line_text[match.end(2):]
                closes_same_tag = remaining_line.lstrip().startswith(f"</{tag_name}>")
                if raw_text.strip() and not closes_same_tag:
                    return {
                        "line": line_number,
                        "column": match.start(2),
                        "message": f"Unexpected text inside <{tag_name}>.",
                    }
        return None

    def validate_dayz_xml_attributes(self, file_text):
        var_name_pattern = re.compile(r"<var\b[^>]*\bname\s*=\s*(['\"])(.*?)\1")
        valid_identifier_pattern = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
        attribute_pattern = re.compile(r"\b([A-Za-z_][\w:.-]*)\s*=\s*(['\"])(.*?)\2")
        numeric_attribute_names = {"x", "y", "z", "a", "r"}
        numeric_value_pattern = re.compile(r"^-?\d+(?:\.\d+)?$")

        for line_number, line_text in enumerate(file_text.splitlines(), start=1):
            for match in var_name_pattern.finditer(line_text):
                var_name = match.group(2)
                if not valid_identifier_pattern.fullmatch(var_name):
                    return {
                        "line": line_number,
                        "column": match.start(2),
                        "message": "Invalid globals variable name.",
                    }
            for match in attribute_pattern.finditer(line_text):
                attribute_name = match.group(1).lower()
                attribute_value = match.group(3).strip()
                if attribute_name in numeric_attribute_names and not numeric_value_pattern.fullmatch(attribute_value):
                    return {
                        "line": line_number,
                        "column": match.start(3),
                        "message": f"Invalid numeric value for {attribute_name}.",
                    }
        return None

    def validate_dayz_xml_classnames(self, file_path, file_text):
        if Path(file_path).name.lower() != "cfgspawnabletypes.xml":
            return None

        known_classnames = self.get_known_dayz_type_classnames(file_path)
        if not known_classnames:
            return None

        type_name_pattern = re.compile(r"<type\b[^>]*\bname\s*=\s*(['\"])(.*?)\1")
        for line_number, line_text in enumerate(file_text.splitlines(), start=1):
            for match in type_name_pattern.finditer(line_text):
                type_name = match.group(2).strip()
                if type_name and self.looks_like_misspelled_dayz_classname(type_name, known_classnames):
                    return {
                        "line": line_number,
                        "column": match.start(2),
                        "message": f"Possible misspelled DayZ type classname: {type_name}.",
                    }

        return None

    def looks_like_misspelled_dayz_classname(self, type_name, known_classnames):
        normalized_type_name = type_name.strip().lower()
        if not normalized_type_name or normalized_type_name in known_classnames:
            return False

        for known_classname in known_classnames:
            if abs(len(normalized_type_name) - len(known_classname)) > 2:
                continue
            if self.small_text_distance(normalized_type_name, known_classname, 2) <= 2:
                return True

        return False

    def small_text_distance(self, left_text, right_text, stop_after):
        previous_row = list(range(len(right_text) + 1))
        for left_index, left_char in enumerate(left_text, start=1):
            current_row = [left_index]
            best_row_value = current_row[0]
            for right_index, right_char in enumerate(right_text, start=1):
                insert_cost = current_row[right_index - 1] + 1
                delete_cost = previous_row[right_index] + 1
                replace_cost = previous_row[right_index - 1] + (left_char != right_char)
                current_value = min(insert_cost, delete_cost, replace_cost)
                current_row.append(current_value)
                best_row_value = min(best_row_value, current_value)
            if best_row_value > stop_after:
                return stop_after + 1
            previous_row = current_row

        return previous_row[-1]

    def get_known_dayz_type_classnames(self, edited_file_path):
        types_path = self.find_types_xml_for_edited_file(edited_file_path)
        if types_path is None:
            return set()

        try:
            types_root = ET.parse(types_path).getroot()
        except (ET.ParseError, OSError):
            return set()

        known_classnames = set()
        for type_element in types_root.findall(".//type"):
            type_name = type_element.get("name")
            if type_name:
                known_classnames.add(type_name.strip().lower())

        return known_classnames

    def find_types_xml_for_edited_file(self, edited_file_path):
        current_path = Path(edited_file_path)
        for parent_path in [current_path.parent, *current_path.parents]:
            types_path = parent_path / "db" / "types.xml"
            if types_path.exists():
                return types_path
            if parent_path.name.lower() == "db":
                sibling_types_path = parent_path / "types.xml"
                if sibling_types_path.exists():
                    return sibling_types_path

        return None

    def validate_json_editor_text(self, file_text):
        try:
            json.loads(file_text)
        except json.JSONDecodeError as error:
            return {
                "line": max(error.lineno, 1),
                "column": max(error.colno - 1, 0),
                "message": error.msg,
            }
        return None

    def validate_cfg_editor_text(self, file_text):
        for line_number, line_text in enumerate(file_text.splitlines(), start=1):
            code_text = line_text.split("//", 1)[0].strip()
            if not code_text or code_text.startswith(("#", "{", "}", "/*", "*")):
                continue
            if "=" not in code_text:
                continue
            if code_text.count('"') % 2:
                return {
                    "line": line_number,
                    "column": line_text.find('"') if '"' in line_text else 0,
                    "message": "Unclosed quotation mark.",
                }
            stripped_line = line_text.rstrip()
            if "//" in line_text and stripped_line.endswith(","):
                return {
                    "line": line_number,
                    "column": len(stripped_line) - 1,
                    "message": "Config comment line has an unexpected trailing comma.",
                }
            if not code_text.endswith(";"):
                return {
                    "line": line_number,
                    "column": max(len(line_text.rstrip()) - 1, 0),
                    "message": "Config assignment is missing a semicolon.",
                }
        return None

    def validate_script_editor_text(self, file_text):
        stack = []
        in_block_comment = False
        pairs = {"(": ")", "[": "]", "{": "}"}
        closing = {")": "(", "]": "[", "}": "{"}

        for line_number, line_text in enumerate(file_text.splitlines(), start=1):
            index = 0
            in_string = False
            string_start_column = 0
            while index < len(line_text):
                current = line_text[index]
                next_char = line_text[index + 1] if index + 1 < len(line_text) else ""

                if in_block_comment:
                    if current == "*" and next_char == "/":
                        in_block_comment = False
                        index += 2
                        continue
                    index += 1
                    continue

                if in_string:
                    if current == "\\":
                        index += 2
                        continue
                    if current == '"':
                        in_string = False
                    index += 1
                    continue

                if current == "/" and next_char == "/":
                    break
                if current == "/" and next_char == "*":
                    in_block_comment = True
                    index += 2
                    continue
                if current == '"':
                    in_string = True
                    string_start_column = index
                    index += 1
                    continue
                if current in pairs:
                    stack.append((current, line_number, index))
                elif current in closing:
                    if not stack or stack[-1][0] != closing[current]:
                        return {
                            "line": line_number,
                            "column": index,
                            "message": f"Unexpected closing {current}.",
                        }
                    stack.pop()
                index += 1

            code_before_comment = line_text.split("//", 1)[0]
            stray_token_match = re.search(r";\s*([A-Za-z_]\w*)\s*$", code_before_comment)
            if stray_token_match:
                return {
                    "line": line_number,
                    "column": stray_token_match.start(1),
                    "message": "Unexpected text after completed statement.",
                }

            if in_string:
                return {
                    "line": line_number,
                    "column": string_start_column,
                    "message": "Unclosed quotation mark.",
                }

        if in_block_comment:
            return {
                "line": max(len(file_text.splitlines()), 1),
                "column": 0,
                "message": "Unclosed block comment.",
            }
        if stack:
            opening, line_number, column_number = stack[-1]
            return {
                "line": line_number,
                "column": column_number,
                "message": f"Unclosed {opening}.",
            }
        return None

    def can_save_editor_file(self, file_path):
        try:
            resolved_file = file_path.resolve()
        except OSError:
            return False

        if not resolved_file.exists() or not resolved_file.is_file():
            return False

        if resolved_file.suffix.lower() not in EDITABLE_FILE_EXTENSIONS:
            return False

        allowed_roots = [DAYZ_SERVER_SOURCE_DIR, MANAGED_SERVER_ROOT, PRACTICE_DAYZ_SERVER_DIR, DLC_RECORDS_DIR]
        for root_path in allowed_roots:
            try:
                resolved_file.relative_to(root_path.resolve())
                return True
            except ValueError:
                continue

        return False

    def load_text_file_for_editing(self, file_path):
        self.pending_delete_file_path = None
        file_path = Path(file_path)
        if not self.can_save_editor_file(file_path):
            self.map_list.hide()
