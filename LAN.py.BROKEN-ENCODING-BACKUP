def write_diagnostic_log(title, details):
    timestamp = time.strftime("%Y-%m-%d %H:%M:%S")
    try:
        with APP_DIAGNOSTIC_LOG.open("a", encoding="utf-8") as log_file:
            log_file.write(f"\n[{timestamp}] {title}\n")
            log_file.write(details.rstrip())
            log_file.write("\n")
    except OSError:
        pass


def handle_unhandled_exception(exception_type, exception, exception_traceback):
    details = "".join(traceback.format_exception(exception_type, exception, exception_traceback))
    write_diagnostic_log("Unhandled exception", details)
    sys.__excepthook__(exception_type, exception, exception_traceback)

