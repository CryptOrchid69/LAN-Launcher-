        return target_path

    def can_copy_source_file(self, source_file):
        if self.active_instructions_root is not None:
            return source_file.exists() and (source_file.is_file() or source_file.is_dir())

        if self.active_primary_dayz_root is not None:
            return self.can_copy_mod_folder(source_file)

        if self.active_mods_root is not None:
            return source_file.exists() and source_file.is_dir() and source_file.name.startswith("@")

        if self.can_copy_mod_folder(source_file):
            return True

        if not source_file.exists() or not source_file.is_file():
            return False

        return source_file.suffix.lower() in REPLACEABLE_FILE_EXTENSIONS

    def can_copy_mod_folder(self, source_path):
        return (
            self.active_primary_dayz_root is not None
            and source_path.exists()
            and source_path.is_dir()
            and source_path.name.startswith("@")
        )

    def add_required_active_mods_under_map_drop(self, parent_item):
        if self.active_mods_server_layout is None:
            return

        mod_names = [mod_info["folder"] for mod_info in REQUIRED_BASE_MODS]
        mod_names.extend(
            mod_name for mod_name in self.active_mods_server_layout.get("workshop_mods", ()) if mod_name.startswith("@")
        )

        seen_mods = set()
        for mod_name in mod_names:
            if mod_name in seen_mods:
                continue

            seen_mods.add(mod_name)
            shared_mod_folder = DAYZ_SERVER_SOURCE_DIR / mod_name
            if not shared_mod_folder.exists() or not shared_mod_folder.is_dir():
                continue

            child_item = QTreeWidgetItem([f"ACTIVE MOD - {mod_name}"])
            child_item.setData(0, Qt.ItemDataRole.UserRole, str(shared_mod_folder))
            parent_item.addChild(child_item)

