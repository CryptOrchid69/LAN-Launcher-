                root_item.setSelected(True)
                self.file_tree.setFocus()
                continue

            if self.active_primary_dayz_root is not None and root_path == self.active_primary_dayz_root:
                root_item = QTreeWidgetItem(["DayZ - drop or paste @mod folders here"])
                root_item.setData(0, Qt.ItemDataRole.UserRole, str(root_path))
                self.file_tree.addTopLevelItem(root_item)
                self.file_tree.setCurrentItem(root_item)
                root_item.setSelected(True)
