    def can_delete_mpmissions_file(self, file_path):
        if self.can_delete_primary_dayz_mod_folder(file_path):
            return True
        if self.can_delete_map_mod_folder(file_path):
            return True
        if self.can_delete_knowledge_center_item(file_path):
            return True
        if self.can_delete_data_cache_file(file_path):
            return True
        if self.can_delete_dsc_records_file(file_path):
            return True

        try:
            resolved_file = file_path.resolve()
        except OSError:
            return False

        if self.active_mpmissions_root is None:
            return False

        if not resolved_file.exists() or not resolved_file.is_file():
            return False

        try:
            resolved_file.relative_to(self.active_mpmissions_root.resolve())
        except ValueError:
            return False

        return True

