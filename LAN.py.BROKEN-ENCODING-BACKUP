        copied_count = 0
        copied_mod_folders = []
        for source_file in source_files:
            if not self.can_copy_source_file(source_file):
                self.speak("This file type cannot be copied into the file browser by LAN Launcher.")
                continue

            if source_file.is_dir() and self.active_primary_dayz_root is not None and not is_knowledge_center_paste:
                target_folder = self.active_primary_dayz_root
            elif source_file.is_dir() and self.active_mods_root is not None and not is_knowledge_center_paste:
                target_folder = self.active_mods_root

            destination_file = target_folder / source_file.name
            try:
                if source_file.is_dir():
                    shutil.copytree(source_file, destination_file, dirs_exist_ok=True)
                    if not is_knowledge_center_paste:
                        copied_mod_folders.append(destination_file)
                else:
                    shutil.copy2(source_file, destination_file)
            except OSError as error:
                self.setWindowTitle(f"{APP_NAME} - File Copy Failed")
                self.speak("Error. The replacement file could not be copied.")
                self.file_tree.hide()
                self.display_window.show()
                self.display_window.setPlainText(f"ERROR: Could not copy replacement file:\n{error}")
                return

            copied_count += 1

        if copied_count == 0:
            return

        self.last_deleted_mpmissions_folder = None
        self.active_tree_paste_folder = None
        self.clear_active_editor_file()
        self.refresh_active_mpmissions_tree()
        if is_knowledge_center_paste:
            self.setWindowTitle(f"{APP_NAME} - Knowledge Center Item Placed")
            if copied_count == 1:
                self.speak("Knowledge Center item placed.")
            else:
                self.speak("Knowledge Center items placed.")
            return

        if copied_mod_folders:
            if self.active_mods_root is not None:
                self.sync_map_mod_list(self.active_mods_root)
            self.transfer_keys_from_primary_dayz_mods(copied_mod_folders)
            self.setWindowTitle(f"{APP_NAME} - Workshop Mod Placed")
            if copied_count == 1:
                self.speak("Workshop mod placed.")
            else:
                self.speak("Workshop mods placed.")
            return

        self.setWindowTitle(f"{APP_NAME} - Replacement File Placed")
        if copied_count == 1:
            self.speak("Replacement file placed.")
        else:
            self.speak("Replacement files placed.")

    def transfer_keys_from_primary_dayz_mods(self, mod_folders):
        total_copied = 0
        scanned_count = 0
        for mod_folder in mod_folders:
            if not mod_folder.exists() or not mod_folder.is_dir():
                continue
            scanned_count += 1
            total_copied += self.copy_missing_mod_keys(mod_folder)

        if scanned_count == 0:
            return

        if total_copied:
            self.append_display_message(
                f"Automatic key transfer completed: {total_copied} key file(s) from {scanned_count} mod folder(s)."
            )
            self.speak("All Keys Transferred.")
        else:
            self.append_display_message("All Keys Have Already Been Transferred.")

    def get_tree_destination_folder(self, target_item):
        if not self.active_file_browser_roots:
            return None

        if target_item is None:
            deleted_folder = self.get_last_deleted_mpmissions_folder()
            if deleted_folder is not None:
                return deleted_folder
            active_folder = self.get_active_tree_paste_folder()
            if active_folder is not None:
                return active_folder
            if self.active_instructions_root is not None:
                return KNOWLEDGE_CENTER_DIR
            return None

        target_path = Path(target_item.data(0, Qt.ItemDataRole.UserRole))
        if target_path.is_file():
            target_path = target_path.parent

        if not target_path.exists() or not target_path.is_dir():
            return None

        if not self.path_is_inside_active_file_browser_roots(target_path):
            return None

        return target_path

    def path_is_inside_active_file_browser_roots(self, target_path):
        try:
            resolved_path = target_path.resolve()
        except OSError:
            return False

        for _, root_path in self.active_file_browser_roots:
            try:
                resolved_root = root_path.resolve()
                resolved_path.relative_to(resolved_root)
                return True
            except (OSError, ValueError):
                continue

        if self.active_instructions_root is not None:
            try:
                resolved_path.relative_to(KNOWLEDGE_CENTER_DIR.resolve())
                return True
            except (OSError, ValueError):
                pass

        return False

    def get_last_deleted_mpmissions_folder(self):
        if self.last_deleted_mpmissions_folder is None:
            return None

        target_path = Path(self.last_deleted_mpmissions_folder)
        if not target_path.exists() or not target_path.is_dir():
            return None

        if not self.path_is_inside_active_file_browser_roots(target_path):
            return None

        return target_path

    def get_active_tree_paste_folder(self):
        if self.active_tree_paste_folder is None:
            return None

        target_path = Path(self.active_tree_paste_folder)
        if not target_path.exists() or not target_path.is_dir():
            return None

        if not self.path_is_inside_active_file_browser_roots(target_path):
