                "then paste your STEAM ID again."
            )
            self.speak("Super Admins file was not found yet. Start a map server first, then paste your Steam I D again.")
            return

        saved_count = 0
        for super_admin_path in super_admin_paths:
            if self.write_steam_id_to_super_admin_file(super_admin_path, steam_id):
                saved_count += 1

        if saved_count:
            self.last_saved_steam_id = steam_id
            self.map_list.hide()
            self.file_tree.hide()
            self.display_window.show()
            self.display_window.setPlainText(
                f"{STEAM_ID_SAVE_CONFIRMED_MESSAGE}\n\n"
