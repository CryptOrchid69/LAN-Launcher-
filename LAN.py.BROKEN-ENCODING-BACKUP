            MANAGED_SERVER_ROOT / server_layout["folder"] / "config" / server_layout["config"]
            for server_layout in SERVER_LAYOUTS
        ]

    def get_available_managed_config_paths(self):
        return [
            config_path
            for config_path in self.get_managed_config_paths()
            if config_path.exists() and config_path.is_file()
        ]

    def get_managed_credentials_paths(self):
        return [
            MANAGED_SERVER_ROOT
            / server_layout["folder"]
            / "profiles"
            / "VPPAdminTools"
            / "Permissions"
            / "credentials.txt"
            for server_layout in SERVER_LAYOUTS
        ]

    def save_admin_password_to_credentials_files(self, admin_password):
        saved_count = 0
        for credentials_path in self.get_managed_credentials_paths():
            if self.write_admin_password_to_credentials_file(credentials_path, admin_password):
                saved_count += 1

        return saved_count

    def write_admin_password_to_credentials_file(self, credentials_path, admin_password):
        existing_lines = []
        template_credentials_path = PROFILE_TEMPLATE_DIR / "VPPAdminTools" / "Permissions" / "credentials.txt"

        if credentials_path.exists():
            try:
                existing_lines = credentials_path.read_text(encoding="utf-8").splitlines()
            except OSError as error:
                self.append_display_message(f"ERROR: Could not read credentials.txt:\n{credentials_path}\n{error}")
                return False
        elif template_credentials_path.exists():
            try:
                existing_lines = template_credentials_path.read_text(encoding="utf-8").splitlines()
            except OSError:
                existing_lines = []

        if existing_lines:
            existing_lines[0] = admin_password
        else:
            existing_lines = [admin_password]

        try:
            credentials_path.parent.mkdir(parents=True, exist_ok=True)
            credentials_path.write_text("\n".join(existing_lines).rstrip() + "\n", encoding="utf-8")
        except OSError as error:
            self.append_display_message(f"ERROR: Could not save credentials.txt:\n{credentials_path}\n{error}")
            return False

        return True

    def show_missing_config_message(self):
